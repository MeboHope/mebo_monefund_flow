# Frontend
VITE_APP_NAME="PesaWeave"
VITE_DEFAULT_CURRENCY=KES
VITE_REQUIRE_SUPABASE_AUTH=true

# Supabase / Auth / Database
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
DATABASE_URL="postgresql://user:password@host:5432/pesaweave"

# Secure payment integration secrets must be server-side only
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY="server-only"
MPESA_CONSUMER_SECRET="server-only"
MPESA_SHORTCODE="server-only"
MPESA_PASSKEY="server-only"
MPESA_CALLBACK_BASE_URL="https://api.example.com/payments/mpesa"

# Optional messaging/notifications
EMAIL_PROVIDER_API_KEY="server-only"
SMS_PROVIDER_API_KEY="server-only"
PUSH_PROVIDER_API_KEY="server-only"

# Optional AI assistant
AI_PROVIDER_API_KEY="server-only"
